# Build output
/target/
**/target/
# Everything under build/ is generated: the ESP tree, the FAT image, the ISO,
# the iso_root staging directory and the QEMU boot-test scratch.
/build/

# Toolchain / editor
.vscode/
.idea/
*.swp

# OS junk
Thumbs.db
.DS_Store

# Local developer overrides
.cargo/config.local.toml
/tools/local/

# Downloaded third-party compatibility runtimes are never vendored into git.
# See documentation/architecture/compatibility.md
/compatibility/windows/vendor/
/compatibility/mac/vendor/

# AI model weights are downloaded on demand, never committed.
/apps/loko-ai/models/
